{
  "manifest_version": "1.0",
  "tools": [
    {
      "name": "search_flights",
      "mutates": false,
      "description": "Search flights between an origin and destination on a given date.",
      "parameters": {
        "type": "object",
        "properties": {
          "origin": {"type": "string"},
          "destination": {"type": "string"},
          "date": {"type": "string"}
        },
        "required": ["origin", "destination", "date"]
      }
    },
    {
      "name": "book_flight",
      "mutates": true,
      "description": "Book a specific flight offer. State-modifying.",
      "parameters": {
        "type": "object",
        "properties": {
          "offer_id": {"type": "string"},
          "passenger_name": {"type": "string"}
        },
        "required": ["offer_id", "passenger_name"]
      }
    },
    {
      "name": "create_support_ticket",
      "mutates": true,
      "description": "Open a support ticket for a device issue. State-modifying.",
      "parameters": {
        "type": "object",
        "properties": {
          "issue_summary": {"type": "string"},
          "device_model": {"type": "string"},
          "severity": {"type": "string"}
        },
        "required": ["issue_summary", "device_model"]
      }
    },
    {
      "name": "lookup_manual",
      "mutates": false,
      "description": "Look up a manual section grounded in a device frame/photo.",
      "parameters": {
        "type": "object",
        "properties": {
          "device_model": {"type": "string"},
          "topic": {"type": "string"}
        },
        "required": ["device_model", "topic"]
      }
    }
  ]
}
