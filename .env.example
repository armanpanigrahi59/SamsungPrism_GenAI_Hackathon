# =============================================================================
# prism-agent environment configuration template
# Copy this file to .env and configure your keys / backend preference.
# =============================================================================

# --- Backend Selection (choose one) ------------------------------------------
# groq_ollama | ollama_groq | groq | ollama | anthropic | regex
PRISM_NLU_BACKEND=groq_ollama

# --- Groq Configuration ------------------------------------------------------
# Get a free key at https://console.groq.com (no credit card required)
GROQ_API_KEY=your_groq_api_key_here
PRISM_GROQ_MODEL=llama-3.1-8b-instant

# --- Ollama Configuration (Local inference) ----------------------------------
# Install Ollama from https://ollama.ai and run: ollama pull llama3.2:1b
OLLAMA_HOST=http://localhost:11434
PRISM_OLLAMA_MODEL=llama3.2:1b

# --- Anthropic Configuration (Optional) ---------------------------------------
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# PRISM_NLU_MODEL=claude-3-5-haiku-20241022

# --- ASR Backend (Optional) ---------------------------------------------------
# PRISM_ASR_BACKEND=whisper
# PRISM_WHISPER_MODEL=base.en
